# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server's ID. Commands show up instantly in this server instead of taking up to an hour.
GUILD_ID=

# One webhook per channel: Channel settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
WEBHOOK_MEDIOCRE=
WEBHOOK_GOOD=
WEBHOOK_GREAT=
WEBHOOK_AMAZING=
WEBHOOK_PERFECT=
WEBHOOK_INSTANT=

# Optional: comma-separated map names. The Instant Complete form shows them as a dropdown (max 25).
MAPS=

# Where the database file lives
DB_PATH=seeds.db

# Optional: the name shown on every seed post. Defaults to the bot's own name.
BOT_NAME=

# Each ranking's channel name must contain its word (mediocre, good, great, amazing, perfect,
# instant) or that ranking is blocked, so seeds can't land in the wrong channel.
# Set to false only if your channels are named differently.
CHECK_CHANNEL_NAMES=true
